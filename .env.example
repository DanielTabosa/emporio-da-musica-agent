# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=your_key_here

# Model used by the agent (default shown)
EMPORIO_MODEL=claude-sonnet-5-5

# The agent's "now", in the store timezone (America/Campo_Grande).
# Orders in the dataset go up to March 2026, so time is frozen at a
# Monday morning in March 2026 by default. Leave empty to use the real clock.
EMPORIO_NOW=2026-03-16 10:00
